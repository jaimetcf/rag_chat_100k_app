# Use a POOLER connection string (Neon pooler, Supabase transaction mode, PgBouncer)
#DATABASE_URL=postgresql://user:password@host-pooler:5432/dbname?pgbouncer=true

OPENAI_API_KEY=sk-proj-...

#ANTHROPIC_API_KEY=sk-ant-...
#AUTH_JWT_SECRET=replace-with-long-random-secret

# Serverless pool: 1 connection per lambda (default)
# PG_POOL_MAX=1

# Distributed rate limits (recommended at 100k DAU)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# GCS: bucket[/optional-prefix]. User files are stored at uploads/<userId>/...
GCP_BUCKET_PATH=your-bucket/uploads
GCP_PROJECT_ID=your-gcp-project
# Path to the downloaded service-account JSON (preferred). Do not paste multiline JSON here.
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
# Optional: minified JSON on one line instead of a key file
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
